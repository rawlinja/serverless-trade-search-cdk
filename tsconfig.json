{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@stacks/*": ["./src/Infrastructure/stacks/*"],
      "@config/*": ["./src/Infrastructure/config/*"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "vitest.config.mts"]
}
